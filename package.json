{
  "name": "uzcord",
  "version": "2.0.0",
  "description": "UzCord — O'zbek Discord serverlari uchun moderatsiya boti va boshqaruv paneli",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy": "tsx src/core/deploy.ts",
    "deploy:prod": "node dist/core/deploy.js",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "better-sqlite3": "^11.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
