{
  "name": "uzcord",
  "version": "2.0.0",
  "description": "UzCord — O'zbek Discord serverlari uchun moderatsiya boti va boshqaruv paneli",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy": "tsx src/core/deploy.ts",
    "deploy:prod": "node dist/core/deploy.js",
    "deploy:guild": "tsx src/core/deploy.ts --guild",
    "deploy:guild:prod": "node dist/core/deploy.js --guild",
    "verify:commands": "tsx src/scripts/verifyCommands.ts",
    "verify:commands:guild": "tsx src/scripts/verifyCommands.ts --guild",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@supabase/supabase-js": "^2.45.4",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
