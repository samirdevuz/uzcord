# ─────────────────────────────────────────────────────────────
#  UzCord bot — sozlamalar
#  Bu faylni nusxalab `.env` deb nomlang va to'ldiring.
#  .env faylini HECH QACHON GitHub'ga yuklamang!
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=bu_yerga_bot_tokeni

# Developer Portal > General Information > Application ID
CLIENT_ID=1551057441750257664

# Test serveringizning ID si (komandalar bir zumda yangilanadi).
# Bo'sh qoldirilsa komandalar global yuklanadi.
DEV_GUILD_ID=

# Bot egalari (vergul bilan ajratilgan Discord ID lar)
OWNER_IDS=

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard > Project Settings > Data API > Project URL
SUPABASE_URL=https://fkqwlxqacylmxkjphfrc.supabase.co

# Supabase Dashboard > Project Settings > API Keys > service_role (secret)
# ⚠️ Bu kalit RLS ni chetlab o'tadi — faqat serverda ishlatiladi,
#    hech qachon brauzerga yoki dashboard frontendiga bermang!
SUPABASE_SERVICE_ROLE_KEY=bu_yerga_service_role_kaliti

# Kesh necha millisekundda bir yangilansin.
# Dashboard'dagi o'zgarish botga shuncha vaqtda yetadi (standart: 60000 = 1 daqiqa)
CACHE_REFRESH_MS=60000

# ── Umumiy ───────────────────────────────────────────────────
# Standart til: uz | ru | en
DEFAULT_LOCALE=uz

# Log darajasi: debug | info | warn | error
LOG_LEVEL=info
