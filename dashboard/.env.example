# ─────────────────────────────────────────────────────────────
#  UzCord dashboard — sozlamalar
#  Lokal: bu faylni `.env.local` deb nusxalang va to'ldiring.
#  Vercel: Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Saytning to'liq manzili (oxirida / siz)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ixtiyoriy: botni taklif qilish havolasi (bo'sh = standart havola)
NEXT_PUBLIC_INVITE_URL=

# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=1551057441750257664

# Developer Portal > OAuth2 > Client Secret > Reset Secret
DISCORD_CLIENT_SECRET=bu_yerga_client_secret

# Supabase Dashboard > Project Settings > Data API > Project URL
SUPABASE_URL=https://fkqwlxqacylmxkjphfrc.supabase.co

# Supabase Dashboard > Project Settings > API Keys > service_role (secret)
# ⚠️ HECH QACHON NEXT_PUBLIC_ prefiksi bilan yozmang!
SUPABASE_SERVICE_ROLE_KEY=bu_yerga_service_role_kaliti

# Sessiya cookie'sini imzolash uchun, kamida 32 belgi. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
